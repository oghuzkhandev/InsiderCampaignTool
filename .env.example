LLM_PROVIDER=mock
ANTHROPIC_API_KEY=

# Yerel PostgreSQL (yalnızca geliştirme için varsayılanlar).
POSTGRES_USER=campaigns
POSTGRES_PASSWORD=campaigns
POSTGRES_DB=campaigns

# İsteğe bağlı: mock SMS/e-posta sağlayıcısının hata ve gecikme davranışı.
# Varsayılanlar (compose.yaml): 50ms gecikme, %3 429 (Retry-After ile), %3 500.
# Hataları kapatmak için oranları 0 yapın. MOCK_PROVIDER_MODE: boş (normal),
# accept_then_drop (her anahtarın ilk kabul yanıtını düşürür) veya
# drop_all_responses (kabul edilenin her yanıtını düşürür).
# MOCK_PROVIDER_LATENCY=50ms
# MOCK_PROVIDER_429_RATE=0.03
# MOCK_PROVIDER_500_RATE=0.03
# MOCK_PROVIDER_RETRY_AFTER=1s
# MOCK_PROVIDER_MODE=

# İsteğe bağlı: testlerin campaigns_test veritabanını oluşturmak için kullandığı
# bakım veritabanı bağlantısı. Testler yalnızca campaigns_test üzerinde yazar.
# TEST_POSTGRES_URL=postgres://campaigns:campaigns@127.0.0.1:5432/postgres?sslmode=disable
